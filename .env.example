# Copiá este archivo a .env.local. Los dos valores de Supabase son los básicos;
# los de Google Calendar sólo hacen falta para activar esa vinculación.
#
# Mientras estas dos variables estén vacías, la aplicación arranca igual en el
# modo de ejemplo: se crea el negocio y se usa el sistema entero, todo guardado
# en el navegador. No viene ningún dato cargado; se arranca vacío, como una
# cuenta nueva. Eso permite que todo el equipo clone y levante el proyecto sin
# esperar a que alguien reparta las claves.
#
# De dónde salen los dos valores, en el panel de Supabase:
#
#   URL   · Project Settings -> Data API -> "Project URL"
#   Clave · Project Settings -> API Keys. Si el proyecto es nuevo vas a ver
#           "Publishable key"; si no, la "anon" de la pestaña Legacy. Las dos
#           sirven, y las dos van igual en NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# Atajo: el botón "Connect" de arriba del panel -> App Frameworks -> Next.js
# te arma las dos líneas con los valores puestos. Ojo que llama a la clave
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: hay que renombrarla a ANON_KEY.
#
# La clave es pública por diseño: viaja al navegador, y lo que impide que
# alguien haga desastres son las políticas RLS de supabase/005_rls.sql.
# La service_role (o cualquier "Secret key") sólo se completa en .env.local
# o en Vercel. Nunca se sube su valor al repositorio.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Opcional si abrís la app en localhost pero el calendario se sirve desde Vercel.
NEXT_PUBLIC_APP_URL=

# Sólo en el servidor de Next/Vercel. No llevan prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI exacta registrada como redirección OAuth en Google Cloud.
GOOGLE_REDIRECT_URI=
# 32 bytes en hexadecimal. Conservar entre despliegues.
GOOGLE_TOKEN_KEY=
CRON_SECRET=

# La API de pagos (cobrar por link o QR). Opcional: mientras esté vacía, con
# Supabase el botón "Pedir un pago por link o QR" aparece apagado y dice por
# qué, y en el modo de ejemplo el pago se simula. Es pública, como la URL de
# Supabase. Las claves del medio de pago viven en el servidor de la API,
# nunca acá. El contrato está en docs/api-pagos.md.
# Incluí /payments al final: https://tu-api.onrender.com/payments
NEXT_PUBLIC_API_URL=
