# Copiá este archivo a .env.local. La que hace andar el sistema es
# NEXT_PUBLIC_API_URL (más abajo): todo pasa por la API. Las de Supabase las
# usan sólo dos rutas del servidor de Next (el calendario .ics y Google
# Calendar), y las de Google Calendar sólo hacen falta para esa vinculación.
#
# Para probar el sistema sin cargar todo a mano, la API siembra una cuenta con
# datos listos: npm run sembrar, en el repo de la API.
#
# De dónde salen los dos valores, en el panel de Supabase:
#
#   URL   · Project Settings -> Data API -> "Project URL"
#   Clave · Project Settings -> API Keys. Si el proyecto es nuevo vas a ver
#           "Publishable key"; si no, la "anon" de la pestaña Legacy. Las dos
#           sirven, y las dos van igual en NEXT_PUBLIC_SUPABASE_ANON_KEY.
#
# Atajo: el botón "Connect" de arriba del panel -> App Frameworks -> Next.js
# te arma las dos líneas con los valores puestos. Ojo que llama a la clave
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: hay que renombrarla a ANON_KEY.
#
# La clave es pública por diseño: viaja al navegador, y lo que impide que
# alguien haga desastres son las políticas RLS de supabase/005_rls.sql.
# La service_role (o cualquier "Secret key") sólo se completa en .env.local
# o en Vercel. Nunca se sube su valor al repositorio.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dominio público canónico. En Vercel, configurarlo en Production y Preview
# con el mismo valor evita que Google vuelva a una preview protegida.
# Ejemplo: https://tp-ing-software-2026c2.vercel.app
# En localhost, el inicio de sesión sigue volviendo a localhost.
NEXT_PUBLIC_APP_URL=

# Sólo en el servidor de Next/Vercel. No llevan prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI exacta registrada como redirección OAuth en Google Cloud.
GOOGLE_REDIRECT_URI=
# 32 bytes en hexadecimal. Conservar entre despliegues.
GOOGLE_TOKEN_KEY=
CRON_SECRET=

# La API: sesión, datos, cobros, todo. Sin ella no se puede entrar. Es
# pública, como la URL de Supabase. Las claves del medio de pago y la
# service_role viven en el servidor de la API, nunca acá. El contrato está en
# docs/api.md y docs/api-pagos.md.
# Puede terminar en /v1, /payments o ir sin sufijo: lib/api.js normaliza las
# tres formas y arma las direcciones nuevas y de compatibilidad (docs/api.md).
NEXT_PUBLIC_API_URL=https://tp-ingesoft-api.onrender.com

# Sólo para las e2e (npm run test:e2e), sin NEXT_PUBLIC_: nunca llegan al
# navegador. La API que siembra las cuentas de prueba, con la siembra
# prendida, y su SEMILLA_CLAVE. Ver README, "Pruebas automatizadas".
E2E_API_URL=http://localhost:4000
E2E_SEMILLA_CLAVE=
