# Copiá este archivo a .env.local y completá los dos valores.
#
# Mientras estas dos variables estén vacías, la aplicación arranca igual en el
# modo de ejemplo: se crea el negocio y se usa el sistema entero, todo guardado
# en el navegador. No viene ningún dato cargado; se arranca vacío, como una
# cuenta nueva. Eso permite que todo el equipo clone y levante el proyecto sin
# esperar a que alguien reparta las claves.
#
# Los valores salen de Supabase: Project Settings -> API.
# La clave anónima es pública por diseño (viaja al navegador). La service_role
# NO va acá ni en ningún archivo del repo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
