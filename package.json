{
  "name": "marmanager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --verbose",
    "test:watch": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js --verbose --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:e2e": "start-server-and-test dev http://localhost:3000 \"wdio run ./wdio.conf.js\"",
    "test:e2e": "start-server-and-test dev http://localhost:3000 \"wdio run ./wdio.conf.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@next/swc-linux-x64-gnu": "^16.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "jest": "^30.0.0",
    "start-server-and-test": "^2.0.0",
    "tailwindcss": "^4.3.3"
  }
}
